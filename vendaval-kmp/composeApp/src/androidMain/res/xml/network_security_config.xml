<?xml version="1.0" encoding="utf-8"?>
<!--
  Every remote endpoint the app talks to is HTTPS (Supabase PostgREST and the
  OpenStreetMap tile CDN), so cleartext is denied outright rather than being
  left at the platform default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
